{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true, "resolveJsonModule": true,
    "isolatedModules": true, "esModuleInterop": true, "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "tests", "scripts", "vite.config.ts", "playwright.config.ts"]
}
